NODE_ENV=development
SERVER_HOST=localhost
SERVER_PORT=3000

# Server-only Feishu OpenAPI settings. Keep secrets out of client code and commits.
FEISHU_OPENAPI_BASE_URL=https://open.feishu.cn
FEISHU_TENANT_ACCESS_TOKEN=replace-with-server-side-token
# Alternative to a pre-issued token:
# FEISHU_APP_ID=replace-with-feishu-app-id
# FEISHU_APP_SECRET=replace-with-server-side-app-secret

# ===== Feishu Base resources (server/modules/wiki-beta) =====
# All values required at runtime — no production defaults in code.
WIKI_BETA_BASE_TOKEN=bascnEXAMPLE000000000000000000000
WIKI_BETA_BASE_URL=https://example.feishu.cn/base/bascnEXAMPLE000000000000000000000
WIKI_BETA_ARTICLE_TABLE_ID=tblEXAMPLEARTICLE00001
WIKI_BETA_ENTITY_TABLE_ID=tblEXAMPLEENTITY00001
WIKI_BETA_RELATION_TABLE_ID=tblEXAMPLERELATION0001
WIKI_BETA_MECHANISM_TABLE_ID=tblEXAMPLEMECHANISM01
WIKI_BETA_RANKING_TABLE_ID=tblEXAMPLERANKING0001
WIKI_BETA_RELATION_CANDIDATE_TABLE_ID=tblEXAMPLERELATION0001
WIKI_BETA_REPORT_TABLE_ID=tblEXAMPLEREPORT00001
WIKI_BETA_QUICK_TOOLS_TABLE_ID=tblEXAMPLEQUICKTOOLS1
WIKI_BETA_AI_CONFIG_TABLE_ID=tblEXAMPLEAICONFIG001

# Bitable attachment field IDs (for download permission context)
WIKI_BETA_COVER_FIELD_ID=fldEXAMPLECOVER0001
WIKI_BETA_TITLE_FIELD_ID=fldEXAMPLETITLE0001
WIKI_BETA_ARTICLE_ATTACHMENT_FIELD_ID=fldEXAMPLEATTACH001
WIKI_BETA_MECHANISM_FIGURE_FIELD_ID=fldEXAMPLEFIGURE001
WIKI_BETA_MECHANISM_ICON_FIELD_ID=fldEXAMPLEICON00001
WIKI_BETA_QUICK_TOOLS_GAME_FILE_FIELD_ID=fldEXAMPLEGAMEFILE1
WIKI_BETA_QUICK_TOOLS_ICON_FIELD_ID=fldEXAMPLEQTICON001
WIKI_BETA_RANKING_HTML_FIELD_ID=fldEXAMPLERANKHTML01

# Optional: default spreadsheet/wiki tokens for sheet-driven ranking rows
# WIKI_BETA_RANKING_APPSTORE_SPREADSHEET_TOKEN=shtEXAMPLEAPPSTORE01
# WIKI_BETA_RANKING_WEIXIN_WIKI_NODE_TOKEN=wikEXAMPLEWEIXIN001

# ===== Base -> PostgreSQL sync (server/modules/base-sync) =====
# WIKI_BETA_SYNC_BASE_TOKEN=
# WIKI_BETA_SYNC_MECHANISM_TABLE=tblEXAMPLEMECHANISM01

# ===== In-site AI chat (server/modules/chat) =====
# CHAT_LLM_BASE_URL=https://llm.example.com/v1
# CHAT_LLM_MODEL=your-model-id
# CHAT_LLM_API_KEY=

# ===== Ops scripts (optional) =====
# WIKI_BETA_SITE_ORIGIN=https://example.feishu.cn
# LLM_BASE_URL=https://llm.example.com/v1
